# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-side AI keys.
# OPENAI_API_KEY lets admins use MixHive-hosted avatar/bio/genre generation.
# Regular users can also store their own OpenAI key in Settings > AI & Creativity.
OPENAI_API_KEY=sk-your-platform-key

# Optional MixHive Pro hosted art generation via Hugging Face Inference.
HUGGINGFACE_API_KEY=hf_your-platform-key

# Legacy Vite names are still accepted by next.config.mjs during migration.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CDN Configuration
NEXT_PUBLIC_CDN_BASE_URL=https://your-cdn-domain.com
CDN_UPLOAD_ENDPOINT=https://your-cdn-endpoint.com/upload
CDN_API_KEY=your_cdn_api_key

# Analytics & Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS_ID=your_vercel_speed_insights_id

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Redis (for caching and real-time features)
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_URL=redis://localhost:16379

# File Upload Configuration
MAX_FILE_SIZE=524288000  # 500MB in bytes
ALLOWED_FILE_TYPES=audio/mp3,audio/wav,audio/flac,audio/aac,audio/ogg,audio/webm,image/jpeg,image/png,image/webp
UPLOAD_CHUNK_SIZE=10485760  # 10MB chunks

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000  # 1 minute

# Email Configuration (for notifications)
EMAIL_FROM=noreply@mixhive.com
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password
EMAIL_SERVER_SECURE=true

# Social Media Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify

SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/auth/callback/soundcloud

# Video Configuration
VIDEO_MAX_SIZE=104857600  # 100MB
VIDEO_ALLOWED_TYPES=video/mp4,video/webm,video/quicktime
VIDEO_QUALITY=high
VIDEO_CONVERSION_ENABLED=true

# WebSocket Configuration
WEBSOCKET_URL=wss://your-domain.com
WEBSOCKET_PORT=3001
WEBSOCKET_MAX_CONNECTIONS=10000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mixhive
DATABASE_SSL_MODE=require

# Security Configuration
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_CONTENT_SECURITY_POLICY=default-src 'self'

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=3600  # 1 hour
CDN_CACHE_TTL=31536000  # 1 year

# Feature Flags
ENABLE_FEATURED_MIXES=true
ENABLE_USER_VERIFICATION=true
ENABLE_DAILY_LIMITS=true
ENABLE_COMMENT_MODERATION=true
ENABLE_SOCIAL_SHARING=true

# Development Configuration
NODE_ENV=development
DEBUG_MODE=false
LOG_LEVEL=info
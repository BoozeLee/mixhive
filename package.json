{
  "name": "mixhive",
  "private": true,
  "version": "0.1.0",
  "description": "A DJ-first social music platform — Facebook meets SoundCloud, built for mixers.",
  "author": "BoozeLee <kiliaanv2@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/BoozeLee/mixhive",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoozeLee/mixhive.git"
  },
  "bugs": {
    "url": "https://github.com/BoozeLee/mixhive/issues"
  },
  "type": "module",
  "scripts": {
    "agents:sync": "node scripts/sync-lua-agents.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-lua-agents.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'Linting skipped for deployment'",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "clean": "rm -rf .next out dist",
    "analyze": "ANALYZE=true npm run build",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:types:check": "supabase gen types typescript --linked | diff - src/lib/database.types.ts",
    "postinstall": "husky install",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:wasmoon": "NODE_OPTIONS=--experimental-vm-modules jest --testEnvironment node --testPathPattern=wasmoon --passWithNoTests",
    "test:all": "node scripts/test.js",
    "test:ci": "npm run type-check && npm run lint && npm run format:check && npm test && npm run build",
    "deploy": "node scripts/deploy.js",
    "deploy:vercel": "vercel --prod --token ${{ secrets.VERCEL_TOKEN }}",
    "deploy:docker": "docker build -t mixhive . && docker run -p 3000:3000 mixhive",
    "smoke": "node scripts/mixhive-test.mjs",
    "smoke:preview": "node scripts/mixhive-test.mjs http://localhost:3000",
    "smoke:browser": "python3 scripts/browser_smoke.py",
    "smoke:legacy": "node scripts/post-deploy-verify.js"
  },
  "dependencies": {
    "@next/font": "14.1.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@sentry/browser": "^10.54.0",
    "@sentry/nextjs": "^10.54.0",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.8.4",
    "@types/three": "^0.184.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "date-fns": "^2.30.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "framer-motion": "^10.16.4",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.11.0",
    "lucide-react": "^0.294.0",
    "mixpanel-browser": "^2.79.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.15.1",
    "redis": "^5.12.1",
    "spotify-web-api-node": "^5.0.2",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "wasmoon": "^1.16.0",
    "waveform-react": "^0.2.3",
    "zod": "^4.4.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.3.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ]
  }
}

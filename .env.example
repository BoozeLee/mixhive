# ─────────────────────────────────────────────────────────────
# MixHive — Environment Variable Reference
# ─────────────────────────────────────────────────────────────
# Copy this file to .env (or .env.development / .env.production)
# and fill in real values where needed.
#
# Required for basic app startup:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Required for server-side features (admin AI, email, Stripe):
#   OPENAI_API_KEY, RESEND_API_KEY, STRIPE_SECRET_KEY
#
# Required for the Active Worker Tier:
#   SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy Vite names — still accepted by next.config.mjs during migration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Auth ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mixhive.vercel.app
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=https://mixhive.vercel.app
NEXTAUTH_SECRET=

# ── AI & Creativity ──────────────────────────────────────────
# Admin path: set OPENAI_API_KEY to let admin users generate avatar/bio/genre
# at platform cost (~$0.04/image). Without it, users must bring their own key
# via Settings → AI & Creativity (BYO path — works immediately, zero platform cost).
OPENAI_API_KEY=
# Pro-tier hosted art via Hugging Face Inference API.
HUGGINGFACE_API_KEY=

# ── Stripe (payments) ────────────────────────────────────────
# WARNING: Payments are gated behind the P14 pre-launch gate. The marketplace
# and subscription code returns 503 if these keys are absent — that is the
# desired safety state until launch.
# Do NOT set live keys in development. Use test keys (sk_test_..., whsec_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (Resend) ───────────────────────────────────────────
# Used by monthly-recap cron. Without it, cron runs but skips sending.
RESEND_API_KEY=
EMAIL_FROM=MixHive <hello@mixhive.app>

# ── CDN ──────────────────────────────────────────────────────
NEXT_PUBLIC_CDN_BASE_URL=https://your-cdn-domain.com
CDN_UPLOAD_ENDPOINT=https://your-cdn-endpoint.com/upload
CDN_API_KEY=your_cdn_api_key
CDN_PROVIDER=cloudflare
CUSTOM_CDN_URL=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_URL=

# ── Audio / Uploads ──────────────────────────────────────────
MAX_FILE_SIZE=524288000
ALLOWED_FILE_TYPES=audio/mp3,audio/wav,audio/flac,audio/aac,audio/ogg,audio/webm,image/jpeg,image/png,image/webp
UPLOAD_CHUNK_SIZE=10485760

# ── WebSocket ────────────────────────────────────────────────
WEBSOCKET_URL=wss://your-domain.com
WEBSOCKET_PORT=443
WEBSOCKET_MAX_CONNECTIONS=10000

# ── Push Notifications (Web Push / VAPID) ────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:hello@mixhive.app

# ── Cron ─────────────────────────────────────────────────────
# Bearer token protecting all /api/cron/* and /api/cleanup endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Analytics & Monitoring ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ── Social Media Integration ─────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://mixhive.app/api/auth/callback/spotify
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=https://mixhive.app/api/auth/callback/soundcloud

# ── Video ────────────────────────────────────────────────────
VIDEO_MAX_SIZE=104857600
VIDEO_ALLOWED_TYPES=video/mp4,video/webm,video/quicktime
VIDEO_QUALITY=high
VIDEO_CONVERSION_ENABLED=true

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mixhive
DATABASE_SSL_MODE=require

# ── Security ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_CONTENT_SECURITY_POLICY=default-src 'self'
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ── Feature Flags ────────────────────────────────────────────
ENABLE_FEATURED_MIXES=true
ENABLE_USER_VERIFICATION=true
ENABLE_DAILY_LIMITS=true
ENABLE_COMMENT_MODERATION=true
ENABLE_SOCIAL_SHARING=true
WEB3_EXPERIMENTS_ENABLED=false
NEXT_PUBLIC_WEB3_EXPERIMENTS_ENABLED=false

# ── Performance ──────────────────────────────────────────────
ENABLE_CACHING=true
CACHE_TTL=3600
CDN_CACHE_TTL=31536000

# ── Worker Tier ──────────────────────────────────────────────
# These can be overridden in ~/.config/mixhive/worker.env
APP_BASE_URL=https://mixhive.vercel.app
AUDIO_BUCKET=mix-audio
POLL_INTERVAL_MS=5000
MAX_CONCURRENT=3
JOB_TIMEOUT_MS=300000
WAVEFORM_POINTS=200

# ── Development ──────────────────────────────────────────────
NODE_ENV=development
DEBUG_MODE=false
LOG_LEVEL=info
ENABLE_DAILY_LIMITS=false
ENABLE_COMMENT_MODERATION=false
